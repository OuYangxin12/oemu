# Build trees
build/
build-*/
out/
cmake-build-*/

# CMake artefacts left behind by in-source configure attempts
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
*.cmake.stamp

# Compilation database (symlinked by `make compile-db`)
compile_commands.json
.cache/

# Object files, libraries, executables
*.o
*.obj
*.lo
*.slo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out

# Coverage data
*.gcno
*.gcda
*.gcov
coverage.info
coverage.info.raw
coverage-html/

# Sanitizer / profiler output
*.log
callgrind.out.*
massif.out.*
perf.data*
vgcore.*
# Anchored to the repository root and restricted to files: a bare `core`
# pattern would also exclude the src/core/ source directory.
/core
/core.*

# Guest benchmark build output and the fetched CoreMark tree. Both are
# regenerable (bench/guest/build.sh, bench/guest/fetch-coremark.sh); the
# corpus blobs under bench/corpus/blob are committed on purpose and are not
# ignored.
bench/guest/build/
bench/guest/coremark-src/

# Guest Linux / qemu workspace (downloads, cross toolchain, kernel build tree,
# rootfs images). Everything under the top-level guest/ is regenerable; the
# roadmap requires that kernel Images and rootfs images never enter the
# repository. Anchored deliberately: an unanchored "guest/" would also swallow
# tests/guest/, which holds the committed acceptance guests.
/guest/

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# clangd editor config (machine-absolute paths); regenerate locally
/.clangd

# boot scratch logs
dbg.err
con.out
