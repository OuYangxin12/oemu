root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,h,cpp,hpp}]
indent_size = 2
max_line_length = 96

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[Makefile]
# Recipe lines require real tabs.
indent_style = tab

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
